# Minimum local stack (FastAPI and PostgreSQL)
# Copy this file to .env, replace the required placeholders, and leave unused
# optional values empty.
#
# WSL note: if Postgres runs on the Windows host and this stack runs under
# WSL2, <database-host> must be the Windows host's NAT gateway address, not
# "localhost" — resolve it fresh with `ip route show default | awk '{print $3}'`
# (illustrative only, e.g. something like 172.x.x.1 — never hardcode a real
# address here). That address can shift across Windows/WSL restarts;
# scripts/dev-start.sh re-syncs it automatically at startup (added in plan
# 46-04), and tests/test_wsl_postgres_reachability.py fails loudly with the
# corrected value if DATABASE_URL/TEST_DATABASE_URL ever drift from it.
DATABASE_URL=postgresql+asyncpg://<database-user>:<database-password>@<database-host>:<database-port>/<database-name>

# Required by FastAPI for authenticated server-to-server admin requests.
# Use the exact same generated value for ADMIN_TOKEN in app/.env.
ADMIN_TOKEN=<generated-admin-token>

# Optional local test database
# Must name a dedicated test database, never the development database.
# On WSL, use the same WSL-gateway host convention documented above.
# Example: postgresql+asyncpg://user:password@<database-host>:5432/scotus_test
TEST_DATABASE_URL=

# Optional LLM parsing
ANTHROPIC_API_KEY=

# Optional object storage (required only for DigitalOcean Spaces PDF uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=

# Deployment-only diagnostics; leave false for normal local and production use.
DEBUG=false
