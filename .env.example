# DATABASE_URL for FastAPI async engine (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://scotus:scotus@localhost:5432/scotus

# Note: Alembic uses postgresql+psycopg2:// (sync driver) not postgresql+asyncpg://
# Set ALEMBIC_URL or override in alembic.ini if needed; FastAPI always uses asyncpg.

ANTHROPIC_API_KEY=sk-ant-...

# Required - FastAPI admin token for server-to-server calls from SvelteKit (Phase 5+).
# No default: API refuses to start without this set.
ADMIN_TOKEN=

# SvelteKit-side env vars (read via $env/static/private, NOT by the Python API):

# HMAC-SHA256 key for the scotus_admin_session cookie (min 32 chars).
# Rotating this value invalidates all existing admin sessions.
SESSION_SECRET=

# Operator login credentials for the admin interface.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Dedicated local test database URL (Phase 31, D-01/D-03). Must point at a
# scotus_test database on the SAME local Postgres server as DATABASE_URL —
# never a remote/shared host. pipeline/tests/conftest.py prefers this over
# DATABASE_URL when resolving the test DB. Provision with:
#   python scripts/provision_test_db.py
TEST_DATABASE_URL=postgresql+asyncpg://scotus:scotus@localhost:5432/scotus_test
