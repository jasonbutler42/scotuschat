# Environment variables — never commit secrets
.env

# Postgres data directory (lives inside repo, gitignored — easy to nuke and recreate)
data/pgsql/
data/pgdata/

# Raw PDF files — immutable source documents, not tracked in git
# The directory itself is tracked via data/pdfs/.gitkeep;
# actual PDF files are ignored via data/pdfs/.gitignore
data/pdfs/*.pdf

# Historical corpus source files (ConvoKit/Oyez) — immutable local source files,
# not tracked in git (utterances.jsonl alone is ~900MB; GitHub hard-blocks >100MiB).
# The directory itself is tracked via data/corpus/.gitkeep;
# actual corpus files are ignored via data/corpus/.gitignore (defense-in-depth here).
data/corpus/*.jsonl

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.venv
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/

# SvelteKit
app/.svelte-kit/
app/build/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Dev-stack orchestration (scripts/dev-start.sh) runtime output — can carry
# connection strings and tokens; regenerated on every run
.dev-logs/

# Backup of .env written by scripts/dev-start.sh before rewriting the DB host
.env.bak

# Playwright MCP persistent browser profile (holds an admin session cookie — never commit)
.playwright-profile/

# Playwright MCP run artifacts (snapshots, console logs, screenshots)
.playwright-mcp/
