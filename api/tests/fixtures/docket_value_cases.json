{
  "metadata": {
    "description": "Shared Python/TypeScript accept/reject fixture for the Phase 38 gap-closure (G-38-6/T-38-20) docket-value authority contract in api/domain/docket_values.py. Consumed by api/tests/test_docket_values.py; a future TypeScript mirror (Plan 38-09) declares the byte-identical pattern/max_length literals against this same file. Check ordering is a hard determinism contract: blank check, then length check, then pattern check -- this matters for cases (like uat_reported_quoted_string) that would independently fail more than one check.",
    "max_length": 64,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
    "check_order": ["empty", "length_exceeded", "invalid_characters"]
  },
  "valid_cases": [
    { "name": "real_docket_dash_shape", "value": "22-915", "normalized": "22-915" },
    { "name": "real_docket_dash_shape_2", "value": "14-556", "normalized": "14-556" },
    { "name": "bare_number", "value": "71", "normalized": "71" },
