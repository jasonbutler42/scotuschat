    { "name": "seed_test_docket", "value": "14-556-TEST-SEED", "normalized": "14-556-TEST-SEED" },
    { "name": "underscore_shape", "value": "14_556", "normalized": "14_556" },
    { "name": "free_text_operator_placeholder", "value": "bananas", "normalized": "bananas" },
