# SvelteKit server-private environment settings.
# These values are consumed only through $env/static/private; do not add PUBLIC_ prefixes.
FASTAPI_BASE_URL=<fastapi-base-url>

# Must exactly match ADMIN_TOKEN in the root .env file.
ADMIN_TOKEN=<generated-admin-token>

# Generate a strong value of at least 32 characters. Rotating it invalidates sessions.
SESSION_SECRET=<generated-session-secret>

# Local operator credentials for the admin interface.
ADMIN_USERNAME=<admin-username>
ADMIN_PASSWORD=<admin-password>
